---
const {studio}=Astro.props;
const initials=studio.name.split(' ').filter(Boolean).slice(0,2).map((w)=>w[0]).join('');
const cover=studio.images?.find((image)=>image.kind==='cover' && image.authorized && image.url);
---
<a class="studio-card" data-modalities={studio.modalities?.join(" ") || "Yoga"} href={`/estudios/${studio.slug}`}>
  <div class:list={["studio-photo",!cover&&"placeholder"]}>
    {cover ? <img src={cover.url} alt={cover.alt || `Espacio de ${studio.name}`} loading="lazy"/> : <span class="placeholder-mark">{initials}</span>}

    {!cover && <span class="photo-status">Foto próximamente</span>}
  </div>
  <div class="studio-copy">
    <div class="studio-topline"><h3>{studio.name}</h3></div>
    <div class="meta">{studio.zone}, CDMX</div>
    <div class="tags">{studio.modalities?.slice(0,3).join(' · ') || 'Yoga'}</div>
  </div>
</a>
