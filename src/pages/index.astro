---
import Base from '../layouts/Base.astro'; import StudioCard from '../components/StudioCard.astro'; import studios from '../data/studios.json';
const featured=studios.slice(0,6); const zones=['Roma Norte','Condesa','Polanco','Del Valle','Coyoacán','Santa Fe'];
---
<Base><main><section class="shell hero"><div class="eyebrow">Tu guía de yoga en México</div><h1>Encuentra dónde practicar yoga.</h1><p>Descubre estudios, estilos y clases en Ciudad de México. Información clara para elegir dónde quieres practicar.</p><div class="search"><div><small>Ubicación</small><span>¿Dónde quieres practicar?</span></div><div><small>Qué buscas</small><span>Principiantes, Vinyasa, relajarte…</span></div><a class="btn primary" href="/cdmx">Buscar</a></div></section><section class="shell section"><h2>Explora CDMX</h2><div class="chips">{zones.map(z=><a class="chip" href="/cdmx">{z}</a>)}</div></section><section class="shell section"><div class="section-head"><div><h2>Estudios para descubrir</h2><div class="muted">Fichas confirmadas para la primera versión de Yamaa.</div></div><a href="/cdmx">Ver todos →</a></div><div class="grid">{featured.map(s=><StudioCard studio={s}/>)}</div></section><section id="guias" class="shell section"><h2>Empieza por lo que buscas</h2><div class="chips"><span class="chip">Nunca he hecho yoga</span><span class="chip">Quiero relajarme</span><span class="chip">Quiero algo intenso</span><span class="chip">Quiero mejorar flexibilidad</span><span class="chip">Meditación</span></div></section></main></Base>
