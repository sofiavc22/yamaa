---
import Base from '../layouts/Base.astro';
import StudioCard from '../components/StudioCard.astro';
import studios from '../data/studios.json';
const featured=studios.slice(0,6);
const filters=['Cerca de mí','Principiantes','Vinyasa','Hot yoga','Relajarme','Algo intenso'];
const zones=['Roma Norte','Condesa','Polanco','Del Valle','Coyoacán','Santa Fe'];
---
<Base>
<main>
  <section class="shell hero-v2">
    <div class="hero-copy">
      <div class="eyebrow">La guía de yoga en México</div>
      <h1>Encuentra dónde practicar yoga.</h1>
      <p>Estudios y clases en Ciudad de México, organizados para que encuentres el lugar que va contigo.</p>
    </div>
    <div class="search search-v2">
      <div><small>Ubicación</small><span>¿Dónde quieres practicar?</span></div>
      <div><small>Qué buscas</small><span>Principiantes, Vinyasa, relajarte…</span></div>
      <a class="btn primary" href="/cdmx">Buscar</a>
    </div>
  </section>

  <section class="shell discover-strip">
    <div class="chips filters">{filters.map(f=><a class="chip" href="/cdmx">{f}</a>)}</div>
  </section>

  <section class="shell section studios-first">
    <div class="section-head">
      <div><div class="kicker">Descubre</div><h2>Estudios de yoga en CDMX</h2></div>
      <a class="text-link" href="/cdmx">Ver los 38 estudios →</a>
    </div>
    <div class="grid">{featured.map(s=><StudioCard studio={s}/>)}</div>
  </section>

  <section class="shell section zones-light">
    <div class="section-head">
      <div><div class="kicker">Explora por zona</div><h2>Yoga cerca de ti</h2></div>
    </div>
    <div class="zone-pills">{zones.map(z=><a href="/cdmx">{z}<span>→</span></a>)}</div>
  </section>

  <section id="guias" class="shell section guides">
    <div class="kicker">Guías de Yamaa</div><h2>No necesitas saber de yoga para empezar.</h2>
    <div class="guide-grid">
      <a href="/cdmx"><span>EMPEZAR</span><h3>Nunca he hecho yoga. ¿Qué clase elijo?</h3><p>Una guía sencilla para encontrar una práctica que se sienta bien para ti.</p></a>
      <a href="/cdmx"><span>ENTENDER</span><h3>Hatha, Vinyasa, Yin… ¿qué significa todo eso?</h3><p>Te explicamos los estilos sin complicarlo.</p></a>
      <a href="/cdmx"><span>CDMX</span><h3>Cómo elegir un estudio de yoga.</h3><p>Qué revisar antes de reservar tu primera clase.</p></a>
    </div>
  </section>
</main>
</Base>