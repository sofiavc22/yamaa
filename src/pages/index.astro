---
import Base from '../layouts/Base.astro';
import StudioCard from '../components/StudioCard.astro';
import studios from '../data/studios.json';
const featured=studios.filter(studio=>!studio.city||studio.city==='Ciudad de México');
const guadalajaraStudios=studios.filter(studio=>studio.city==='Guadalajara'||studio.city==='Zapopan');
const zones=['Roma Norte','Condesa','Polanco','Del Valle','Coyoacán','Santa Fe'];
const structuredData={
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'Organization','@id':'https://www.clasedeyoga.com.mx/#organization',name:'Yamaa',url:'https://www.clasedeyoga.com.mx/'},
    {'@type':'WebSite','@id':'https://www.clasedeyoga.com.mx/#website',name:'Yamaa',url:'https://www.clasedeyoga.com.mx/',publisher:{'@id':'https://www.clasedeyoga.com.mx/#organization'},inLanguage:'es-MX'}
  ]
};
---
<Base structuredData={structuredData}>
<main>
  <section class="shell explore-hero">
    <h1>Encuentra clases de yoga cerca de ti</h1>
  </section>

  <div class="discovery-sticky">
    <div class="shell">
    <form class="wellness-search" action="/cdmx" role="search">
      <label><span>¿Dónde practicamos?</span><input id="city-search" type="search" list="available-cities" placeholder="Toda la Ciudad de México" aria-label="Escribe una ciudad" autocomplete="off" /></label>
      <label><span>Tu práctica</span><select name="estilo" aria-label="Estilo de yoga"><option value="">Explora a tu ritmo</option>{['Vinyasa','Hatha','Rocket','Restaurativo','Yin'].map(f=><option value={f}>{f}</option>)}</select></label>
      <button class="search-submit" type="submit" aria-label="Buscar estudios"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><span>Buscar</span></button>
    </form>
    <datalist id="available-cities"><option value="Ciudad de México"/><option value="Guadalajara"/><option value="Zapopan"/></datalist>
    <nav class="practice-tabs category-tabs" aria-label="Explora Yamaa">
      {[
        {label:'Estudios',icon:'⌂',id:'estudios'},
        {label:'Retiros',icon:'☼',id:'retiros'},
        {label:'Experiencias',icon:'✳',id:'experiencias'},
        {label:'Certificaciones',icon:'◇',id:'certificaciones'}
      ].map((category,i)=><button type="button" class:list={['practice-tab',i===0&&'active']} data-category={category.id} aria-pressed={i===0?'true':'false'}><span class="category-icon" aria-hidden="true">{category.icon}</span><span>{category.label}</span></button>)}
    </nav>
    </div>
  </div>

  <section class="shell section studios-first" data-studios-content>
    <div class="section-head">
      <div><h2>Clases de Yoga en CDMX</h2></div>
      <a class="text-link" href="/cdmx">Ver todos →</a>
    </div>
    <div class="city-carousel" aria-label="Estudios de yoga en CDMX" tabindex="0">{featured.map(s=><StudioCard studio={s}/>)}</div>
  </section>

  {guadalajaraStudios.length>0 && <section class="shell section" data-studios-content>
    <div class="section-head">
      <div><h2>Clases de Yoga en Guadalajara y Zapopan</h2></div>
      <a class="text-link" href="/guadalajara">Ver todos →</a>
    </div>
    <div class="city-carousel" aria-label="Estudios de yoga en Guadalajara y Zapopan" tabindex="0">{guadalajaraStudios.map(s=><StudioCard studio={s}/>)}</div>
  </section>}

  <section class="shell section category-empty" hidden aria-live="polite">
    <h2 id="category-heading"></h2>
    <p class="muted">Estamos preparando esta selección para ti. Vuelve pronto para descubrir más.</p>
  </section>

  <section class="shell section zones-light">
    <div class="section-head">
      <div><div class="kicker">Explora por zona</div><h2>Yoga cerca de ti</h2></div>
    </div>
    <div class="zone-pills">{zones.map(z=><a href={({'Roma Norte':'/cdmx/roma-norte','Polanco':'/cdmx/polanco','Del Valle':'/cdmx/del-valle'}[z]) || `/cdmx?zona=${encodeURIComponent(z)}`}>{z}<span>→</span></a>)}</div>
  </section>

  <section id="guias" class="shell section guides">
    <div class="kicker">Guías de Yamaa</div><h2>No necesitas saber de yoga para empezar.</h2>
    <div class="guide-grid">
      <a href="/cdmx"><span>EMPEZAR</span><h3>Nunca he hecho yoga. ¿Qué clase elijo?</h3><p>Una guía sencilla para encontrar una práctica que se sienta bien para ti.</p></a>
      <a href="/cdmx"><span>ENTENDER</span><h3>Hatha, Vinyasa, Yin… ¿qué significa todo eso?</h3><p>Te explicamos los estilos sin complicarlo.</p></a>
      <a href="/cdmx"><span>CDMX</span><h3>Cómo elegir un estudio de yoga.</h3><p>Qué revisar antes de reservar tu primera clase.</p></a>
    </div>
  </section>
</main>
</Base>

<script>
const cityForm=document.querySelector<HTMLFormElement>('.wellness-search');
const cityInput=document.querySelector<HTMLInputElement>('#city-search');
const normalizeCity=(value:string)=>value.trim().toLocaleLowerCase('es').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
const cityDestinations=[
 {name:'Ciudad de México',aliases:['cdmx','mexico','ciudad de mexico'],path:'/cdmx'},
 {name:'Guadalajara',aliases:['guadalajara','gdl'],path:'/guadalajara'},
 {name:'Zapopan',aliases:['zapopan'],path:'/guadalajara'}
];
cityInput?.addEventListener('input',()=>cityInput.setCustomValidity(''));
cityForm?.addEventListener('submit',event=>{
 const query=normalizeCity(cityInput?.value||'');
 if(!query)return;
 const match=cityDestinations.find(city=>city.aliases.some(alias=>alias===query))||cityDestinations.find(city=>city.aliases.some(alias=>alias.startsWith(query)));
 if(!match){event.preventDefault();cityInput?.setCustomValidity('Por ahora puedes buscar en Ciudad de México, Guadalajara o Zapopan.');cityInput?.reportValidity();return;}
 event.preventDefault();
 const destination=new URL(match.path,window.location.origin);
 const style=cityForm.querySelector<HTMLSelectElement>('select[name="estilo"]')?.value;
 if(style)destination.searchParams.set('estilo',style);
 window.location.assign(destination.toString());
});
const carousel=document.querySelector<HTMLElement>('.studios-first .city-carousel');
if(carousel){
 const cards=[...carousel.children];
 for(let i=cards.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[cards[i],cards[j]]=[cards[j],cards[i]];}
 cards.forEach((card,index)=>{card.toggleAttribute('hidden',index>=6);carousel.appendChild(card);});
}

const categoryNames={retiros:'Retiros de Yoga',experiencias:'Experiencias de Yoga',certificaciones:'Certificaciones de Yoga'};
document.querySelectorAll('[data-category]').forEach(button=>{
  button.addEventListener('click',()=>{
    const category=button.getAttribute('data-category');
    document.querySelectorAll('[data-category]').forEach(tab=>{const active=tab===button;tab.classList.toggle('active',active);tab.setAttribute('aria-pressed',String(active));});
    document.querySelectorAll('[data-studios-content]').forEach(section=>section.toggleAttribute('hidden',category!=='estudios'));
    const empty=document.querySelector('.category-empty');
    empty?.toggleAttribute('hidden',category==='estudios');
    const heading=document.querySelector('#category-heading');
    if(heading)heading.textContent=categoryNames[category]||'';
  });
});
</script>
