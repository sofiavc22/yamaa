---
import Base from '../../layouts/Base.astro';
import studios from '../../data/studios.json';
export function getStaticPaths(){return studios.map(studio=>({params:{slug:studio.slug},props:{studio}}))}
const {studio}=Astro.props;
const wa=studio.whatsapp?`https://wa.me/${studio.whatsapp}?text=${encodeURIComponent('Hola, encontré tu estudio en Yamaa ¿Me pueden compartir más información?')}`:'';
const mapsQuery=encodeURIComponent([studio.name,studio.address,studio.zone,'Ciudad de México'].filter(Boolean).join(', '));
const maps=`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const website=studio.website || (studio.instagram && !studio.instagram.includes('instagram.com') ? studio.instagram : '');
const instagram=studio.instagram?.includes('instagram.com') ? studio.instagram : '';
const authorizedImages=(studio.images || []).filter((image)=>image.authorized && image.url);
const cover=authorizedImages.find((image)=>image.kind==='cover') || authorizedImages[0];
const gallery=authorizedImages.filter((image)=>image!==cover).slice(0,2);
const title=studio.seoTitle || `${studio.name} — Yoga en ${studio.zone} | Yamaa`;
const description=studio.seoDescription || `Conoce ${studio.name} en ${studio.zone}, CDMX: estilos de yoga, ubicación y enlaces oficiales para planear tu visita.`;
const verifiedLabel=studio.verifiedAt
  ? new Intl.DateTimeFormat('es-MX',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${studio.verifiedAt}T00:00:00Z`))
  : '';
const pageUrl=`https://www.clasedeyoga.com.mx/estudios/${studio.slug}`;
const structuredData={
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':'SportsActivityLocation',
      '@id':`${pageUrl}#studio`,
      name:studio.name,
      description,
      url:pageUrl,
      address:{'@type':'PostalAddress',streetAddress:studio.address || undefined,addressLocality:'Ciudad de México',addressRegion:'CDMX',addressCountry:'MX'},
      image:authorizedImages.map((image)=>new URL(image.url,'https://www.clasedeyoga.com.mx').href),
      sameAs:[website,instagram].filter(Boolean),
      telephone:studio.whatsapp ? `+${studio.whatsapp}` : undefined
    },
    {
      '@type':'BreadcrumbList',
      itemListElement:[
        {'@type':'ListItem',position:1,name:'Inicio',item:'https://www.clasedeyoga.com.mx/'},
        {'@type':'ListItem',position:2,name:'Yoga en CDMX',item:'https://www.clasedeyoga.com.mx/cdmx'},
        {'@type':'ListItem',position:3,name:studio.name,item:pageUrl}
      ]
    }
  ]
};
---
<Base title={title} description={description} structuredData={structuredData}>
<main class="shell detail">
  <div class="studio-breadcrumb"><a href="/cdmx">Yoga en CDMX</a><span>›</span><span>{studio.zone}</span></div>
  <div class="detail-heading"><div><div class="eyebrow">Estudio confirmado · {studio.zone}</div><h1>{studio.name}</h1><p class="detail-sub">{studio.type} · {studio.modalities?.slice(0,3).join(' · ')}</p></div><button class="save-detail favorite-button" data-studio-slug={studio.slug} aria-label="Guardar estudio">♡ Guardar</button></div>
  <div class:list={["photo-layout",gallery.length===0&&"single"]}>
    <div class:list={["studio-photo","detail-photo",!cover&&"placeholder"]}>{cover ? <img src={cover.url} alt={cover.alt || `Espacio de ${studio.name}`}/> : <><span class="placeholder-mark">{studio.name.split(' ').filter(Boolean).slice(0,2).map(w=>w[0]).join('')}</span><span class="photo-status">Fotos próximamente</span></>}</div>
    {gallery.length>0 && <div class="photo-side">{gallery.map(image=><img src={image.url} alt={image.alt || `${studio.name}, ${studio.zone}`} loading="lazy"/>)}</div>}
  </div>
  <div class="detail-grid">
    <div class="detail-main">
      <section class="detail-section"><div class="section-label">Lo esencial</div><h2>Sobre {studio.name}</h2><p class="detail-intro">{studio.summary || `Estudio de ${studio.type.toLowerCase()} en ${studio.zone}, Ciudad de México. En Yamaa reunimos información práctica para ayudarte a decidir dónde practicar antes de contactar al estudio.`}</p></section>
      <section class="detail-section"><div class="section-label">Práctica</div><h2>Clases y estilos</h2><div class="chips">{studio.modalities?.map(m=><span class="chip">{m}</span>)}</div></section>
      <section class="detail-section location-section"><div class="section-label">Ubicación</div><h2>{studio.zone}, CDMX</h2><p class="muted">{studio.address || 'Consulta la ubicación exacta en Google Maps.'}</p><a class="inline-action" href={maps} target="_blank" rel="noopener">Ver ubicación en Google Maps ↗</a></section>
      <section class="visit-details"><div class="section-label">Información para planear tu visita</div><h2>Horarios, precios y reservas</h2><div class="visit-facts">
        <div class="visit-fact"><h3>Horarios</h3><p>{studio.scheduleSummary || 'Consulta los horarios vigentes directamente con el estudio.'}</p>{studio.scheduleUrl && <a class="inline-action" href={studio.scheduleUrl} target="_blank" rel="noopener" data-outbound-kind="schedule">Ver horarios oficiales ↗</a>}</div>
        <div class="visit-fact"><h3>Precios</h3><p>{studio.pricingSummary || 'Pregunta por la clase de prueba, clases individuales y paquetes disponibles.'}</p>{studio.pricingUrl && <a class="inline-action" href={studio.pricingUrl} target="_blank" rel="noopener" data-outbound-kind="pricing">Consultar precios oficiales ↗</a>}</div>
        {studio.beginnerNote && <div class="visit-fact"><h3>Para principiantes</h3><p>{studio.beginnerNote}</p></div>}
      </div></section>
    </div>
    <aside class="detail-aside">
      {wa && <div class="contact-card"><div class="section-label">Contacto</div><h3>¿Quieres practicar aquí?</h3><p>Pregunta directamente al estudio por clases, disponibilidad y reservas.</p><a class="btn primary full" href={wa} target="_blank" rel="noopener" data-outbound-kind="whatsapp">Contactar al estudio</a></div>}
      <div class="link-card"><div class="section-label">Enlaces oficiales</div>{studio.bookingUrl && <a href={studio.bookingUrl} target="_blank" rel="noopener" data-outbound-kind="booking">Reservar <span>↗</span></a>}{instagram && <a href={instagram} target="_blank" rel="noopener" data-outbound-kind="instagram">Instagram <span>↗</span></a>}{website && <a href={website} target="_blank" rel="noopener" data-outbound-kind="website">Sitio web <span>↗</span></a>}<a href={maps} target="_blank" rel="noopener" data-outbound-kind="maps">Google Maps <span>↗</span></a></div>
      <div class="trust-note"><strong>Información confirmada</strong><p>Yamaa reúne información pública y oficial del estudio.{verifiedLabel && <> Verificada el <time datetime={studio.verifiedAt}>{verifiedLabel}</time>.</>}</p>{studio.verificationSource && <small>Fuente: {studio.verificationSource}</small>}</div>
    </aside>
  </div>
</main>
<script>
import { supabase } from '../../lib/supabase.js';
const fav=document.querySelector('.favorite-button');
const slug=fav?.dataset.studioSlug;
let currentUser=null;
let isFavorite=false;
const paintFavorite=()=>{if(!fav)return;fav.textContent=isFavorite?'♥ Guardado':'♡ Guardar';fav.setAttribute('aria-pressed',String(isFavorite));};
const loadFavorite=async()=>{if(!currentUser||!slug)return;const {data,error}=await supabase.from('favorites').select('studio_slug').eq('user_id',currentUser.id).eq('studio_slug',slug).maybeSingle();if(!error){isFavorite=!!data;paintFavorite();}};
const applyAuth=async(session)=>{const signedIn=!!session?.user;currentUser=session?.user||null;if(signedIn)await loadFavorite();else{isFavorite=false;paintFavorite();}};
window.addEventListener('yamaa-auth',(e)=>applyAuth(e.detail.session));
fav?.addEventListener('click',async()=>{if(!currentUser){window.location.href='/registro';return;}fav.disabled=true;if(isFavorite){const {error}=await supabase.from('favorites').delete().eq('user_id',currentUser.id).eq('studio_slug',slug);if(!error)isFavorite=false;}else{const {error}=await supabase.from('favorites').insert({user_id:currentUser.id,studio_slug:slug});if(!error)isFavorite=true;}paintFavorite();fav.disabled=false;});
document.querySelectorAll('[data-outbound-kind]').forEach((link)=>link.addEventListener('click',()=>{
  const detail={studioSlug:slug,kind:link.getAttribute('data-outbound-kind'),href:link.getAttribute('href')};
  window.dispatchEvent(new CustomEvent('yamaa-outbound',{detail}));
  const dataLayer=(window as Window & {dataLayer?: unknown[]}).dataLayer;
  if(Array.isArray(dataLayer))dataLayer.push({event:'studio_outbound_clicked',studio_slug:slug,outbound_kind:detail.kind,outbound_url:detail.href});
}));
</script>
</Base>
