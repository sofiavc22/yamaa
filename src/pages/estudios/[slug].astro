---
import Base from '../../layouts/Base.astro'; import studios from '../../data/studios.json';
export function getStaticPaths(){return studios.map(studio=>({params:{slug:studio.slug},props:{studio}}))}
const {studio}=Astro.props; const wa=studio.whatsapp?`https://wa.me/${studio.whatsapp}?text=${encodeURIComponent('Hola, encontré tu estudio en Yamaa ¿Me pueden compartir más información?')}`:'';
---
<Base title={`${studio.name} — Yoga en ${studio.zone} | Yamaa`}><main class="shell detail"><div class="eyebrow">{studio.zone} · CDMX</div><h1>{studio.name}</h1><div class="meta">{studio.type} {studio.address && ` · ${studio.address}`}</div><div class="photo detail-photo"></div><div class="detail-grid"><div><h2>Sobre este estudio</h2><p class="muted">En Yamaa reunimos información para ayudarte a comparar dónde practicar. Esta ficha forma parte de nuestro directorio confirmado.</p><h2>Prácticas</h2><div class="chips">{studio.modalities?.map(m=><span class="chip">{m}</span>)}</div><h2>Ubicación</h2><div class="map"><strong>{studio.address || `${studio.zone}, Ciudad de México`}</strong></div></div><aside><div class="panel lock"><div class="eyebrow">Información completa</div><h2>Conoce antes de ir</h2><p class="muted">Regístrate gratis para consultar precios, horarios, clase de prueba, amenidades y cómo reservar.</p><a class="btn primary full" href="/registro">Crear cuenta gratis</a></div>{wa && <div class="panel top"><h3>¿Quieres tomar una clase?</h3><p class="muted">Contacta directamente al estudio.</p><a class="btn full" href={wa} target="_blank" rel="noopener">Contactar al estudio</a></div>}<div class="panel top"><h3>También puedes encontrarlo en</h3>{studio.instagram && <a href={studio.instagram} target="_blank">Instagram ↗</a>}</div></aside></div></main></Base>
