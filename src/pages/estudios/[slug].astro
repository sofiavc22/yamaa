---
import Base from '../../layouts/Base.astro'; import studios from '../../data/studios.json';
export function getStaticPaths(){return studios.map(studio=>({params:{slug:studio.slug},props:{studio}}))}
const {studio}=Astro.props;
const wa=studio.whatsapp?`https://wa.me/${studio.whatsapp}?text=${encodeURIComponent('Hola, encontré tu estudio en Yamaa ¿Me pueden compartir más información?')}`:'';
const mapsQuery=encodeURIComponent([studio.name,studio.address,studio.zone,'Ciudad de México'].filter(Boolean).join(', '));
const maps=`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const website=studio.website || (studio.instagram && !studio.instagram.includes('instagram.com') ? studio.instagram : '');
const instagram=studio.instagram?.includes('instagram.com') ? studio.instagram : '';
const authorizedImages=(studio.images || []).filter((image)=>image.authorized && image.url);
const cover=authorizedImages.find((image)=>image.kind==='cover') || authorizedImages[0];
const gallery=authorizedImages.filter((image)=>image!==cover).slice(0,4);
---
<Base title={`${studio.name} — Yoga en ${studio.zone} | Yamaa`}><main class="shell detail"><div class="eyebrow">{studio.zone} · CDMX</div><h1>{studio.name}</h1><div class="meta">{studio.type} {studio.address && ` · ${studio.address}`}</div><div class:list={["studio-photo","detail-photo",!cover&&"placeholder"]}>{cover ? <img src={cover.url} alt={cover.alt || `Espacio de ${studio.name}`}/> : <><span class="placeholder-mark">{studio.name.split(' ').filter(Boolean).slice(0,2).map((w)=>w[0]).join('')}</span><span class="photo-status">Fotos próximamente</span></>}</div>{gallery.length>0 && <div class="studio-gallery">{gallery.map((image)=><img src={image.url} alt={image.alt || `${studio.name}, ${studio.zone}`} loading="lazy"/>)}</div>}<div class="detail-grid"><div><h2>Sobre este estudio</h2><p class="muted">En Yamaa reunimos información para ayudarte a comparar dónde practicar. Esta ficha forma parte de nuestro directorio confirmado.</p><h2>Prácticas</h2><div class="chips">{studio.modalities?.map(m=><span class="chip">{m}</span>)}</div><h2>Ubicación</h2><div class="map"><div><strong>{studio.address || `${studio.zone}, Ciudad de México`}</strong><a class="map-link" href={maps} target="_blank" rel="noopener">Abrir en Google Maps ↗</a></div></div></div><aside><div class="panel lock"><div class="eyebrow">Información completa</div><h2>Conoce antes de ir</h2><p class="muted">Regístrate gratis para consultar precios, horarios, clase de prueba, amenidades y cómo reservar.</p><a class="btn primary full" href="/registro">Crear cuenta gratis</a></div>{wa && <div class="panel top"><h3>¿Quieres tomar una clase?</h3><p class="muted">Contacta directamente al estudio.</p><a class="btn full" href={wa} target="_blank" rel="noopener">Contactar al estudio</a></div>}<div class="panel top"><h3>Enlaces del estudio</h3><div class="external-links">{instagram && <a href={instagram} target="_blank" rel="noopener">Instagram ↗</a>}{website && <a href={website} target="_blank" rel="noopener">Sitio web ↗</a>}<a href={maps} target="_blank" rel="noopener">Google Maps ↗</a></div></div></aside></div></main></Base>