---
import Base from '../../layouts/Base.astro';
import StudioCard from '../../components/StudioCard.astro';
import allStudios from '../../data/studios.json';
const studios=allStudios.filter(studio=>!studio.city||studio.city==='Ciudad de México');

const allStyles=[...new Map(studios.flatMap(studio=>studio.modalities||[]).map(style=>[style.toLocaleLowerCase('es'),style])).values()].sort((a,b)=>a.localeCompare(b,'es'));
const zoneOrder = ['Roma Norte', 'Condesa', 'San Miguel Chapultepec', 'Polanco', 'Del Valle', 'Escandón', 'Coyoacán', 'Santa Fe'];



const faqs = [
  { question: '¿Cuánto cuesta una clase de yoga en CDMX?', answer: 'El precio depende del estudio, la modalidad y el tipo de paquete. En cada ficha mostramos la información pública disponible o un enlace a la tarifa oficial para que confirmes el precio vigente antes de reservar.' },
  { question: '¿Cómo encuentro horarios disponibles?', answer: 'Abre la ficha del estudio que te interesa. Cuando el estudio publica su calendario, encontrarás un enlace directo a sus horarios o sistema oficial de reservas.' },
  { question: '¿Hay clases para principiantes?', answer: 'Sí. Revisa las modalidades y la nota para principiantes de cada ficha. Si el nivel no está indicado, confirma directamente con el estudio antes de asistir.' },
  { question: '¿Qué zona tiene más opciones?', answer: `En este directorio, Polanco, Roma Norte, Del Valle y Condesa concentran la mayor cantidad de fichas. En total puedes comparar ${studios.length} estudios en ${zoneOrder.length} zonas de CDMX.` }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': 'https://www.clasedeyoga.com.mx/cdmx#page', name: 'Clases y estudios de yoga en CDMX: precios y horarios', description: `Compara ${studios.length} estudios de yoga en CDMX por colonia, estilo, horarios y precios publicados.`, url: 'https://www.clasedeyoga.com.mx/cdmx', inLanguage: 'es-MX' },
    { '@type': 'ItemList', name: 'Estudios de yoga en Ciudad de México', numberOfItems: studios.length, itemListElement: studios.map((studio, index) => ({ '@type': 'ListItem', position: index + 1, name: studio.name, url: `https://www.clasedeyoga.com.mx/estudios/${studio.slug}` })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.clasedeyoga.com.mx/' }, { '@type': 'ListItem', position: 2, name: 'Yoga en CDMX', item: 'https://www.clasedeyoga.com.mx/cdmx' }] },
    { '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }
  ]
};
---

<Base title="Clases y estudios de yoga en CDMX: precios y horarios | Yamaa" description={`Compara ${studios.length} estudios de yoga en CDMX por colonia y estilo. Consulta ubicación, horarios, precios publicados y enlaces para reservar.`} structuredData={structuredData}>
  <main id="top" class="city-results-page">
    <header class="results-sticky">
      <div class="shell results-search-row">
        <a class="results-back" href="/" aria-label="Volver al inicio"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H4m7-7-7 7 7 7"/></svg></a>
        <button type="button" class="results-search-pill" data-open-filters><strong>Yoga en Ciudad de México</strong><span id="results-search-caption">Todas las zonas · Todos los estilos</span></button>
        <button type="button" class="results-filter-button" data-open-filters aria-label="Abrir filtros"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/><circle cx="8" cy="6" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="9" cy="18" r="2"/></svg><span id="results-filter-badge" hidden></span></button>
      </div>
      <nav class="shell results-filter-chips" aria-label="Filtrar por estilo de yoga">
        {['Todos','Vinyasa','Hatha','Restaurativo','Rocket','Yin','Ashtanga'].map((style,index)=><a class="chip" href={index===0?'/cdmx':`/cdmx?estilo=${encodeURIComponent(style)}`} data-style-filter={index===0?'':style} aria-current={index===0?'true':undefined}>{style}</a>)}
      </nav>
    </header>
    <section class="shell results-content" aria-labelledby="city-results-title">
      <h1 id="city-results-title">{studios.length} estudios de yoga en CDMX</h1>
      <div class="results-count sr-only" role="status" aria-live="polite"></div>
      <div class="results-empty" hidden><h2>No encontramos estudios con esos filtros</h2><p>Prueba con otra zona o estilo para encontrar tu próxima práctica.</p><a class="btn" href="/cdmx">Quitar filtros</a></div>
      <div class="grid results-grid">{studios.map(studio=><StudioCard studio={studio} listing={true}/>)}</div>
    </section>
    <dialog class="results-filter-sheet" aria-labelledby="results-filter-title">
      <form action="/cdmx" method="get">
        <header><button type="button" class="results-close" aria-label="Cerrar filtros">×</button><h2 id="results-filter-title">Encuentra tu práctica</h2></header>
        <div class="filter-scroll-body">
        <fieldset class="filter-group"><legend>¿En qué zona?</legend><div class="filter-options">{['',...zoneOrder].map(zone=><label class="filter-choice"><input type="radio" name="zona" value={zone} checked={!zone}/><span>{zone||'Todas'}</span></label>)}</div></fieldset>
        <fieldset class="filter-group"><legend>Estilo de Yoga</legend><div class="filter-options">{['',...allStyles].map(style=><label class="filter-choice"><input type="radio" name="estilo" value={style} checked={!style}/><span>{style||'Todos los estilos'}</span></label>)}</div></fieldset>
        <fieldset class="filter-group"><legend>Precio de tu primera visita</legend><p class="filter-help">Por persona, en MXN. Distribución de los precios disponibles.</p>
        <div class="price-histogram" aria-hidden="true">{Array.from({length:14},(_,i)=>{const n=studios.filter(s=>typeof s.firstClassPrice==='number'&&s.firstClassPrice>=150+i*20&&s.firstClassPrice<170+i*20).length;return <span data-bin={150+i*20} style={`height:${Math.max(4,n*12)}px`}></span>})}</div>
        <div class="price-sliders"><label><span class="sr-only">Precio mínimo</span><input type="range" name="min" min="150" max="420" step="5" value="150"/></label><label><span class="sr-only">Precio máximo</span><input type="range" name="max" min="150" max="420" step="5" value="420"/></label></div>
        <div class="price-values"><output id="min-price">$150 MXN</output><output id="max-price">$420 MXN</output></div>
        <label class="filter-check"><input type="checkbox" name="donativo" value="1"/>Solo clases con donativo</label>
        <p class="filter-help">Al ajustar el rango se muestran solo estudios con precio confirmado.</p></fieldset>
        <label>Nombre del estudio<input type="search" name="q" placeholder="Busca tu estudio" autocomplete="off"/></label>
        </div>
        <footer><button type="button" class="filter-reset">Quitar filtros</button><button class="btn primary" type="submit" id="show-filter-results">Mostrar estudios</button></footer>
      </form>
    </dialog>

    <section class="city-zone-links"><div class="shell"><h2>Explora estudios por zona</h2><p>Compara las opciones y modalidades registradas en cada colonia.</p><div class="zone-pills"><a href="/cdmx/roma-norte">Roma Norte <span>→</span></a><a href="/cdmx/polanco">Polanco <span>→</span></a><a href="/cdmx/del-valle">Del Valle <span>→</span></a></div></div></section>

    <section class="city-faq">
      <div class="shell">
        <div class="eyebrow">Antes de reservar</div><h2>Preguntas sobre clases de yoga en CDMX</h2>
        <div class="results-faq-list">{faqs.map(faq=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div>
      </div>
    </section>
  </main>
</Base>

<script>
let params=new URLSearchParams(window.location.search);
const normalize=(value:string)=>value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const cards=[...document.querySelectorAll<HTMLElement>('.results-grid .studio-card')];
const matches=(card:HTMLElement,p:URLSearchParams)=>{
 const zone=p.get('zona')||'',style=p.get('estilo')||'',query=p.get('q')||'';
 const price=card.dataset.price?Number(card.dataset.price):null;
 return (!zone||card.dataset.zone===zone)&&(!style||normalize(card.dataset.modalities||'').includes(normalize(style)))&&(!query||normalize(card.querySelector('h3')?.textContent||'').includes(normalize(query)))&&(!p.has('min')&&!p.has('max')||(price!==null&&price>=Number(p.get('min')||150)&&price<=Number(p.get('max')||420)))&&(!p.has('donativo')||card.dataset.donation==='true');
};
const renderResults=()=>{
const visibleCards=cards.filter(card=>{const visible=matches(card,params);card.hidden=!visible;return visible;});
const count=visibleCards.length;
visibleCards.slice(0,3).forEach(card=>{const image=card.querySelector<HTMLImageElement>('img');if(image){image.loading='eager';image.fetchPriority='high';}});
const zone=params.get('zona')||'',style=params.get('estilo')||'',query=params.get('q')||'';
const summary=`${count} ${count===1?'estudio de yoga':'estudios de yoga'} ${zone?'en '+zone:'en CDMX'}`;
const title=document.querySelector('#city-results-title');if(title)title.textContent=summary;
const status=document.querySelector('.results-count');if(status)status.textContent=summary;
document.querySelector('.results-empty')?.toggleAttribute('hidden',count>0);
const caption=document.querySelector('#results-search-caption');if(caption)caption.textContent=[zone||'Todas las zonas',style||'Todos los estilos',query,params.has('min')||params.has('max')?'$'+(params.get('min')||150)+'–$'+(params.get('max')||420):'',params.has('donativo')?'Donativo':''].filter(Boolean).join(' · ');
const badge=document.querySelector('#results-filter-badge');const activeCount=[zone,style,query,params.has('min')||params.has('max'),params.has('donativo')].filter(Boolean).length;if(badge){badge.textContent=String(activeCount);badge.toggleAttribute('hidden',!activeCount);}
document.querySelectorAll<HTMLAnchorElement>('[data-style-filter]').forEach(link=>{const value=link.dataset.styleFilter||'';const next=new URLSearchParams(params);if(value)next.set('estilo',value);else next.delete('estilo');link.href='/cdmx'+(next.size?'?'+next:'');if(normalize(value)===normalize(style))link.setAttribute('aria-current','true');else link.removeAttribute('aria-current');});
};
renderResults();
const sheet=document.querySelector<HTMLDialogElement>('.results-filter-sheet');
const form=sheet?.querySelector('form');
const min=form?.querySelector<HTMLInputElement>('[name=min]');const max=form?.querySelector<HTMLInputElement>('[name=max]');
let priceActive=params.has('min')||params.has('max');
const syncForm=()=>form?.querySelectorAll<HTMLInputElement>('input').forEach(input=>{
 const value=params.get(input.name);
 if(input.type==='radio')input.checked=normalize(input.value)===normalize(value||'');
 else if(input.type==='checkbox')input.checked=params.has(input.name);
 else if(value!==null)input.value=value;
});
syncForm();
const draft=()=>{const p=new URLSearchParams(new FormData(form!) as any);for(const [key,value] of [...p])if(!value)p.delete(key);if(!priceActive||p.has('donativo')){p.delete('min');p.delete('max');}return p;};
const preview=()=>{
 if(!form||!min||!max)return;
 const p=draft();const n=cards.filter(card=>matches(card,p)).length;
 const slider=form.querySelector<HTMLElement>('.price-sliders');slider?.style.setProperty('--range-start',((Number(min.value)-150)/270*100)+'%');slider?.style.setProperty('--range-end',((Number(max.value)-150)/270*100)+'%');
 const button=document.querySelector('#show-filter-results');if(button)button.textContent=`Mostrar ${n} ${n===1?'estudio':'estudios'}`;
 document.querySelector('#min-price')!.textContent='$'+min.value+' MXN';document.querySelector('#max-price')!.textContent='$'+max.value+' MXN';
 document.querySelectorAll<HTMLElement>('[data-bin]').forEach(bar=>bar.classList.toggle('out-of-range',priceActive&&(Number(bar.dataset.bin)+20<Number(min.value)||Number(bar.dataset.bin)>Number(max.value))));
 const donation=form.querySelector<HTMLInputElement>('[name=donativo]')!.checked;min.disabled=donation;max.disabled=donation;
};
form?.addEventListener('input',event=>{if(event.target===min||event.target===max){priceActive=true;if(Number(min!.value)>Number(max!.value)){if(event.target===min)max!.value=min!.value;else min!.value=max!.value;}}preview();});
const applyFilters=(p:URLSearchParams)=>{params=p;history.pushState(null,'','/cdmx'+(p.size?'?'+p:''));renderResults();syncForm();priceActive=p.has('min')||p.has('max');sheet?.close();document.querySelector('.results-content')?.scrollIntoView({block:'start'});};
form?.addEventListener('submit',event=>{event.preventDefault();applyFilters(draft());});
document.querySelectorAll<HTMLAnchorElement>('[data-style-filter]').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();applyFilters(new URL(link.href).searchParams);}));
window.addEventListener('popstate',()=>{params=new URLSearchParams(window.location.search);renderResults();syncForm();priceActive=params.has('min')||params.has('max');});
document.querySelector('.filter-reset')?.addEventListener('click',()=>{form?.reset();priceActive=false;preview();});
document.querySelectorAll('[data-open-filters]').forEach(button=>button.addEventListener('click',()=>{preview();sheet?.showModal();}));
document.querySelector('.results-close')?.addEventListener('click',()=>sheet?.close());
sheet?.addEventListener('click',event=>{if(event.target===sheet){const box=sheet.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)sheet.close();}});
</script>
