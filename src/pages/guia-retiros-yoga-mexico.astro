---
import Base from '../layouts/Base.astro';
import {upcomingRetreats, whatsappRetreat} from '../data/retreats.js';

const title='Los mejores retiros de yoga en México 2026–2027 | Yamaa';
const description='Explora retiros de yoga en México 2026 y 2027. Compara fechas, destinos, precios, hospedaje, alimentos y actividades en la guía de Yamaa.';
const states=[...new Set(upcomingRetreats.map(r=>r.state))].sort((a,b)=>a.localeCompare(b,'es'));
const formatted=(date)=>new Intl.DateTimeFormat('es-MX',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z'));
const structuredData={'@context':'https://schema.org','@type':'CollectionPage',name:title,description,url:'https://www.clasedeyoga.com.mx/guia-retiros-yoga-mexico',inLanguage:'es-MX'};
---
<Base title={title} description={description} structuredData={structuredData}>
<main class="retreats-page">
  <section class="shell retreat-hero">
    <p class="kicker">GUÍA YAMAA · 2026–2027</p>
    <h1>Un viaje para volver a ti.</h1>
    <p>Los mejores retiros de yoga en México, reunidos para que encuentres tu próxima pausa. Explora destinos, compara programas y conecta directamente con sus organizadores.</p>
    <a class="btn primary" href="#explorar-retiros">Explorar retiros ↓</a>
  </section>
  <section class="shell retreat-intro">
    <h2>¿Y si tu próximo viaje fuera para ti?</h2>
    <p>No para cumplir pendientes ni llenar la agenda, sino para regalarte unos días de movimiento, descanso y reconexión. Desde las montañas de Puebla y Morelos hasta las playas de Oaxaca, Nayarit y Jalisco, hay una experiencia para cada momento.</p>
    <div class="retreat-info-grid">
      <article><strong>Una pausa de un día</strong><span>Para descubrir el yoga y el bienestar sin viajar durante una semana.</span></article>
      <article><strong>Un fin de semana para ti</strong><span>Yoga, meditación y descanso cerca de la naturaleza.</span></article>
      <article><strong>Una inmersión profunda</strong><span>Experiencias de una o varias semanas para profundizar en tu práctica.</span></article>
    </div>
  </section>
  <section class="shell retreat-catalog" id="explorar-retiros">
    <div class="retreat-heading"><div><p class="kicker">EXPLORA A TU RITMO</p><h2>Encuentra tu próximo retiro</h2></div><p id="retreat-count" aria-live="polite">{upcomingRetreats.length} opciones</p></div>
    <div class="retreat-filters" role="search" aria-label="Filtrar retiros">
      <label>Destino<select id="retreat-state"><option value="">Todos los estados</option>{states.map(s=><option value={s}>{s}</option>)}</select></label>
      <label>Presupuesto<select id="retreat-budget"><option value="">Todos los precios</option><option value="5000">Hasta $5,000</option><option value="10000">Hasta $10,000</option><option value="20000">Hasta $20,000</option><option value="more">Más de $20,000</option></select></label>
      <label>Duración<select id="retreat-duration"><option value="">Todas las duraciones</option><option value="day">Un día</option><option value="multi">Varios días</option></select></label>
    </div>
    <p class="retreat-disclaimer">Precios publicados por organizadores, sujetos a cambios. Algunos corresponden únicamente al programa, sin hospedaje ni alimentos. Las fechas y condiciones se deben confirmar directamente antes de reservar.</p>
    <div class="retreat-list" id="retreat-list">
      {upcomingRetreats.map(retreat=><article class="retreat-card" data-state={retreat.state} data-price={retreat.price??''} data-duration={retreat.start===retreat.end?'day':'multi'}>
        <div class="retreat-card-top"><span>{formatted(retreat.start)}{retreat.start!==retreat.end?' — '+formatted(retreat.end):''}</span><span>{retreat.duration}</span></div>
        <div class="retreat-card-body">
          <div class="retreat-card-content">
            <span class="retreat-place">⌁ {retreat.location}</span>
            <h3>{retreat.name}</h3>
            <p class="retreat-organizer">{retreat.organizer}</p>
            <p>{retreat.intro}</p>
            {retreat.included?.length>0&&<div class="retreat-includes"><strong>¿Qué incluye?</strong><ul>{retreat.included.map(x=><li>{x}</li>)}</ul></div>}
            {retreat.notIncluded?.length>0&&<p class="retreat-not-included"><strong>No incluido:</strong> {retreat.notIncluded.join('; ')}</p>}
            {retreat.language&&<p class="retreat-not-included"><strong>Idioma:</strong> {retreat.language}</p>}
            {retreat.status!=='complete'&&<p class="retreat-pending">Información pendiente de confirmar. Consulta los detalles con el organizador.</p>}
          </div>
          <aside class="retreat-card-side">
            <span>Precio por persona</span>
            <strong>{retreat.priceLabel}</strong>
            {whatsappRetreat(retreat)&&<a href={whatsappRetreat(retreat)} target="_blank" rel="noopener noreferrer" class="retreat-action">Consultar por WhatsApp ↗</a>}
            {retreat.website&&<a href={retreat.website} target="_blank" rel="noopener noreferrer" class="retreat-action">Ver retiro oficial ↗</a>}
            {retreat.source&&<a href={retreat.source} target="_blank" rel="noopener noreferrer" class="retreat-secondary">Red social del organizador ↗</a>}
          </aside>
        </div>
      </article>)}
    </div>
    <div id="retreat-empty" class="retreat-empty" hidden>No encontramos retiros con esos filtros. Prueba otro destino o presupuesto.</div>
  </section>
  <section class="shell retreat-advice">
    <p class="kicker">ANTES DE ELEGIR</p>
    <h2>Lo importante no es solo el destino.</h2>
    <p>Antes de reservar, revisa si el precio incluye habitación privada o compartida, comidas, traslados, clases de yoga, políticas de cancelación e idioma. Si viajas sola o es tu primer retiro, pregunta si el programa recibe personas principiantes.</p>
    <p>Yamaa es una guía independiente de descubrimiento: no organiza estos retiros, no garantiza disponibilidad y no procesa reservaciones ni pagos. Cada experiencia se contrata directamente con su organizador.</p>
  </section>
</main>
</Base>
<script>
const state=document.querySelector<HTMLSelectElement>('#retreat-state');
const budget=document.querySelector<HTMLSelectElement>('#retreat-budget');
const duration=document.querySelector<HTMLSelectElement>('#retreat-duration');
const cards=[...document.querySelectorAll<HTMLElement>('.retreat-card')];
const count=document.querySelector('#retreat-count');
const empty=document.querySelector<HTMLElement>('#retreat-empty');
const update=()=>{
 let visible=0;
 for(const card of cards){
  const price=card.dataset.price?Number(card.dataset.price):null;
  const max=budget?.value;
  const priceMatch=!max||(price!==null&&(max==='more'?price>20000:price<=Number(max)));
  const show=(!state?.value||card.dataset.state===state.value)&&(!duration?.value||card.dataset.duration===duration.value)&&priceMatch;
  card.hidden=!show;if(show)visible++;
 }
 if(count)count.textContent=visible+' '+(visible===1?'opción':'opciones');
 if(empty)empty.hidden=visible!==0;
};
[state,budget,duration].forEach(el=>el?.addEventListener('change',update));
</script>
<style>
.retreats-page{background:linear-gradient(#f6f4ee 0,#fff 390px)}.retreat-hero{padding:86px 0 68px;max-width:1100px}.retreat-hero h1{font-size:clamp(46px,7vw,92px);line-height:1;letter-spacing:-.075em;max-width:820px;font-weight:550;margin:17px 0 24px}.retreat-hero>p:not(.kicker){font-size:clamp(16px,2vw,21px);line-height:1.55;color:var(--muted);max-width:690px;margin:0 0 30px}.retreat-hero .btn{display:inline-flex}.retreat-intro{padding:28px 0 60px}.retreat-intro h2,.retreat-advice h2{font-size:clamp(28px,4vw,47px);font-weight:550;letter-spacing:-.05em;margin:0 0 18px}.retreat-intro>p,.retreat-advice>p:not(.kicker){max-width:750px;color:var(--muted);line-height:1.8;font-size:16px}.retreat-info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:35px}.retreat-info-grid article{border:1px solid var(--line);padding:24px;border-radius:19px;display:flex;flex-direction:column;gap:11px;background:#fff}.retreat-info-grid strong{font-size:18px;font-weight:600}.retreat-info-grid span{color:var(--muted);line-height:1.6;font-size:14px}.retreat-catalog{padding:40px 0 80px}.retreat-heading{display:flex;justify-content:space-between;align-items:end;gap:24px}.retreat-heading h2{font-size:clamp(29px,4vw,44px);font-weight:550;letter-spacing:-.05em;margin:12px 0 0}.retreat-heading>p{color:var(--muted);white-space:nowrap}.retreat-filters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:24px 0}.retreat-filters label{display:flex;flex-direction:column;gap:9px;font-size:13px;font-weight:650}.retreat-filters select{width:100%;border:1px solid var(--line);background:#fff;border-radius:12px;padding:15px;font-size:14px;color:var(--ink)}.retreat-disclaimer{color:var(--muted);font-size:13px;line-height:1.7;margin:16px 0 30px}.retreat-list{display:grid;gap:20px}.retreat-card{border:1px solid var(--line);border-radius:22px;background:#fff;overflow:hidden}.retreat-card[hidden]{display:none}.retreat-card-top{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding:15px 25px;color:var(--brand);font-size:12px;font-weight:750}.retreat-card-body{display:grid;grid-template-columns:minmax(0,1fr) 230px}.retreat-card-content{padding:27px}.retreat-place{font-size:13px;color:var(--brand);font-weight:600}.retreat-card h3{font-size:clamp(25px,3vw,35px);font-weight:550;letter-spacing:-.04em;line-height:1.13;margin:12px 0 5px}.retreat-organizer{color:var(--muted);font-size:13px;margin:0 0 17px!important}.retreat-card-content>p:not(.retreat-organizer){font-size:14px;line-height:1.8;color:#5d605b}.retreat-includes{margin-top:20px}.retreat-includes strong{font-size:13px}.retreat-includes ul{padding-left:19px;margin:9px 0 0;color:#555;line-height:1.8;font-size:13px}.retreat-pending{color:#887856!important;font-size:12px!important}.retreat-not-included{font-size:12px!important}.retreat-card-side{border-left:1px solid var(--line);padding:27px 22px;display:flex;flex-direction:column;gap:13px;background:#fbfaf7}.retreat-card-side>span{font-size:12px;color:var(--muted)}.retreat-card-side>strong{font-size:19px;line-height:1.3;font-weight:650;letter-spacing:-.03em}.retreat-action{border:1px solid var(--brand);background:var(--brand);color:white;border-radius:999px;padding:13px 15px;font-size:12px;text-align:center;font-weight:650}.retreat-secondary{font-size:12px;color:var(--brand);text-align:center;padding:6px}.retreat-empty{padding:40px;text-align:center;border-radius:18px;background:var(--warm)}.retreat-advice{padding:55px 0 90px;border-top:1px solid var(--line)}
@media(max-width:700px){.retreat-hero{padding:48px 0 45px}.retreat-intro{padding:15px 0 35px}.retreat-info-grid{grid-template-columns:1fr;gap:10px}.retreat-info-grid article{padding:19px}.retreat-heading{align-items:start}.retreat-filters{grid-template-columns:1fr;gap:10px}.retreat-card-top{padding:14px 17px;flex-wrap:wrap}.retreat-card-body{grid-template-columns:1fr}.retreat-card-content{padding:23px 19px}.retreat-card-side{border-left:0;border-top:1px solid var(--line);padding:20px}.retreat-advice{padding:42px 0 60px}}
</style>